{
  "name": "douyin-messenger-opensource",
  "version": "1.0.0",
  "description": "抖音多账号直播场控系统（开源版）— Douyin Multi-Account Live Messenger",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "start": "electron .",
    "build": "webpack --mode production && npm run copy-views",
    "copy-views": "powershell -Command \"Copy-Item -Path 'src\\renderer\\views', 'src\\renderer\\assets' -Destination 'dist\\renderer\\' -Recurse -Force\""
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "fs-extra": "^11.3.4",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.80.0",
    "webpack-cli": "^5.1.0",
    "webpack-node-externals": "^3.0.0"
  },
